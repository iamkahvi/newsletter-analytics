{
  "name": "newsletter_backup",
  "version": "1.0.0",
  "private": true,
  "author": "Kahvi Patel <iamkahvi@gmail.com>",
  "license": "MIT",
  "scripts": {
    "sync": "bun run scripts/sync_links.ts",
    "fetch": "bash scripts/get_text.sh link_list.txt output/html-filtered",
    "convert": "bun run scripts/process_html_to_markdown.ts --mode list link_list.txt --output output/markdown",
    "combine": "bun run scripts/combine_markdown.ts",
    "organize": "bash cleanup.sh",
    "analyze": "bun run scripts/analyze_markdown.ts output/markdown",
    "analyze:nlp": "bun run scripts/analyze_natural.ts output/markdown",
    "topics": "bun run scripts/x.ts",
    "pipeline": "bun run sync && bun run fetch && bun run convert && bun run combine && bun run analyze",
    "fetch-metadata": "bun run scripts/fetch_metadata.ts",
    "inventory-images": "bun run scripts/inventory_images.ts",
    "download-images": "bun run scripts/download_images.ts",
    "upload-images": "bash scripts/upload_images_to_r2.sh",
    "deep-analyze": "bun run scripts/deep_analysis.ts",
    "site": "bun run scripts/serve.ts"
  },
  "dependencies": {
    "@types/jsdom": "^28.0.0",
    "compromise": "^14.10.1",
    "defuddle": "^0.12.0",
    "jsdom": "^28.1.0",
    "natural": "^8.0.1"
  },
  "devDependencies": {
    "bun-types": "^1.1.42"
  }
}
